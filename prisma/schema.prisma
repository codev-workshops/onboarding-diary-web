// Prisma schema — per docs/DATA_MODEL.md
// SQLite lacks native enums; enum-like fields are strings validated at the app
// layer (zod) against the documented value sets. Postgres-ready.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  name         String
  role         String    @default("RECRUIT") // RECRUIT | MANAGER | ADMIN
  department   String?
  startDate    DateTime?
  active       Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  tasks       TaskEntry[]
  issues      IssueEntry[]
  feedback    FeedbackEntry[]
  notes       NoteEntry[]
  managedBy   ManagerAssignment[] @relation("Recruit")
  manages     ManagerAssignment[] @relation("Manager")

  checklistTemplates   ChecklistTemplate[]   @relation("TemplateCreator")
  checklistAssignments ChecklistAssignment[] @relation("AssignmentRecruit")
  checklistsAssigned   ChecklistAssignment[] @relation("AssignmentAssigner")
}

model ManagerAssignment {
  id        String   @id @default(cuid())
  managerId String
  recruitId String
  createdAt DateTime @default(now())

  manager User @relation("Manager", fields: [managerId], references: [id], onDelete: Cascade)
  recruit User @relation("Recruit", fields: [recruitId], references: [id], onDelete: Cascade)

  @@unique([managerId, recruitId])
  @@index([managerId])
  @@index([recruitId])
}

model TaskEntry {
  id          String   @id @default(cuid())
  authorId    String
  date        DateTime
  title       String
  description String?
  category    String // GENERAL | TRAINING | SETUP | MEETING | DOCUMENTATION | OTHER
  status      String   @default("TODO") // TODO | IN_PROGRESS | DONE | BLOCKED
  priority    String   @default("MEDIUM") // LOW | MEDIUM | HIGH
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([authorId])
  @@index([authorId, date])
}

model IssueEntry {
  id              String   @id @default(cuid())
  authorId        String
  date            DateTime
  title           String
  description     String?
  severity        String // LOW | MEDIUM | HIGH | CRITICAL
  status          String   @default("OPEN") // OPEN | IN_PROGRESS | RESOLVED
  resolutionNotes String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([authorId])
  @@index([authorId, date])
}

model FeedbackEntry {
  id        String   @id @default(cuid())
  authorId  String
  date      DateTime
  subject   String
  type      String // POSITIVE | SUGGESTION | CONCERN
  details   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([authorId])
  @@index([authorId, date])
}

model ChecklistTemplate {
  id          String   @id @default(cuid())
  title       String
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  createdBy   User                  @relation("TemplateCreator", fields: [createdById], references: [id], onDelete: Cascade)
  items       ChecklistTemplateItem[]
  assignments ChecklistAssignment[]

  @@index([createdById])
}

model ChecklistTemplateItem {
  id         String @id @default(cuid())
  templateId String
  text       String
  order      Int

  template    ChecklistTemplate         @relation(fields: [templateId], references: [id], onDelete: Cascade)
  completions ChecklistItemCompletion[]

  @@unique([templateId, order])
  @@index([templateId])
}

model ChecklistAssignment {
  id           String   @id @default(cuid())
  templateId   String
  recruitId    String
  assignedById String
  createdAt    DateTime @default(now())

  template    ChecklistTemplate         @relation(fields: [templateId], references: [id], onDelete: Cascade)
  recruit     User                      @relation("AssignmentRecruit", fields: [recruitId], references: [id], onDelete: Cascade)
  assignedBy  User                      @relation("AssignmentAssigner", fields: [assignedById], references: [id], onDelete: Cascade)
  completions ChecklistItemCompletion[]

  @@unique([templateId, recruitId])
  @@index([recruitId])
  @@index([templateId])
}

model ChecklistItemCompletion {
  id           String   @id @default(cuid())
  assignmentId String
  itemId       String
  completedAt  DateTime @default(now())

  assignment ChecklistAssignment   @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  item       ChecklistTemplateItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([assignmentId, itemId])
  @@index([assignmentId])
}

model NoteEntry {
  id        String   @id @default(cuid())
  authorId  String
  date      DateTime
  title     String
  content   String
  tags      String   @default("") // comma-separated; exposed as array in API
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([authorId])
  @@index([authorId, date])
}
